# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string, including the database name:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pencilbox
MONGODB_URI=YOUR_MONGODB_URI

# Random string, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=YOUR_RANDOM_32_PLUS_CHAR_SECRET

# Image storage on Cloudinary. Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Leave empty to save uploads to public/uploads (local only; not persistent on Vercel).
CLOUDINARY_URL=YOUR_CLOUDINARY_URL

# Passwords for `npm run seed`. If empty, random ones are generated and printed once.
SEED_OWNER_PASSWORD=
SEED_CASHIER_PASSWORD=

# The shop WhatsApp number that customer orders open, with country code and digits only (India: 91XXXXXXXXXX).
# Without it the website still works but shows "ordering will open soon" instead of the WhatsApp button.
WHATSAPP_NUMBER=YOUR_WHATSAPP_NUMBER
